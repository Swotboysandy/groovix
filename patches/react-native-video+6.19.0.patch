+package com.brentvatne.exoplayer;
+
+/**
+ * Groovix: the app's handlers for Next / Previous pressed on the notification,
+ * lock screen, headphones or a Bluetooth device. The player itself holds one
+ * song, so these go to the app's own queue.
+ */
+public final class RemoteControlHooks {
+    public static volatile Runnable onNext = null;
+    public static volatile Runnable onPrevious = null;
+
+    private RemoteControlHooks() {}
+}
