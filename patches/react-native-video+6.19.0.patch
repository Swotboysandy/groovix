+package com.brentvatne.exoplayer;
+
+import androidx.media3.common.audio.AudioProcessor;
+
+/**
+ * Groovix: audio processors the app inserts into every player's audio sink
+ * (its equaliser). Set once from the app before playback starts.
+ */
+public final class AudioProcessorHooks {
+    public static volatile AudioProcessor[] processors = new AudioProcessor[0];
+
+    private AudioProcessorHooks() {}
+}
